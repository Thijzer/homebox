# Image tag from docker.io/thijs/obsidian-server.
OBSIDIAN_SERVER_IMAGE_TAG=latest
OBSIDIAN_SERVER_CONTAINER_NAME=obsidian-server

# Required: comma-separated name=url clone pairs for the two vaults, e.g.
# home=https://github.com/<user>/home-repo,work=https://github.com/<user>/work-repo
VAULTS=

# Required: GitHub token with read + write on both vault repos.
# A fine-grained PAT scoped to the two repos (Contents: Read and write) is enough.
GH_TOKEN=

# Required: static bearer token MCP clients send in the Authorization header.
# The server refuses to start without it.
MCP_AUTH_TOKEN=

# Optional: MCP port on the host; the container always listens on 8080.
MCP_PORT=8080

# Optional: debug | info | warn | error | silent (default info)
LOG_LEVEL=info
