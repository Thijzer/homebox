# Image tag. The image is built from Dockerfile.prod; the push script publishes
# latest plus matching versioned tags. Use a versioned tag for reproducible
# deployments.
FAM_PLAN_IMAGE_TAG=latest

FAM_PLAN_CONTAINER_NAME=fam-plan

# Host port for the web UI; the container listens on 80.
FAM_PLAN_PORT=18000

# Persistent directory for the SQLite database (container path /app/var/data).
# The directory must exist before the first run.
FAM_PLAN_DATA_PATH=./fam-plan-data

# Required: Symfony secret used for sessions and URL signing. Generate one with:
#   openssl rand -hex 32
APP_SECRET=

# Bearer token that MCP clients must send to POST /mcp. The image ships a
# placeholder default, so set a real token when agents will use the endpoint.
MCP_API_TOKEN=

# Messenger transport for the queue worker that the image entrypoint starts.
# The doctrine:// transport creates its own table on first use.
MESSENGER_TRANSPORT_DSN=doctrine://default

# Set this when the app runs behind a reverse proxy or tailscale serve.
SYMFONY_TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# Optional: FrankenPHP worker restarts after this many requests (default 500).
MAX_REQUESTS=500
