# Image tag. Slim runtime by default; use a devtools tag when you need to
# debug inside the container (devtools-min-latest or devtools-latest).
# Matching versioned tags exist for reproducible deployments.
DSH_IMAGE_TAG=latest

DSH_CONTAINER_NAME=deepseek-harness

# Proxy port inside the container (LAN entry point) and the host port.
DSH_PROXY_HOST_PORT=3080
DSH_PROXY_PORT=3080
# DSH source port inside the container; must differ from the proxy port.
DSH_PORT=3079

# HTTP Basic Auth. Auth is enabled only when BOTH values are set; if either
# is empty, access is completely open. Set real values in Arcane's project
# environment instead of this file.
DSH_PROXY_USERNAME=REPLACE_ME_IN_ARCANE
DSH_PROXY_PASSWORD=REPLACE_ME_IN_ARCANE

# Persistent DSH session and configuration data (container path /root/.dsh).
DSH_DATA_PATH=/var/apps/deepseek-harness
